---
import Layout from "../layouts/Layout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
---

<Layout
  title="Careers"
  description="Explore careers in engineering, field services and business operations at JB Advanced Engineering Limited."
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Careers</span>
      </div>
      <p class="eyebrow">BUILD YOUR NEXT CHAPTER</p>
      <h1>Career Opportunities</h1>
      <p class="description">
        Technical curiosity. Careful execution. A commitment to getting the
        details right.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container form-layout">
      <aside class="form-aside">
        <p class="eyebrow">CAREERS AT JBAEL</p>
        <h2>Bring your expertise.</h2>
        <p>
          We welcome expressions of interest from engineering, field service and
          business professionals who share our commitment to precision,
          reliability and quality.
        </p>
        <p>
          Tell us about your skills, experience and area of interest so we can
          understand where your expertise could contribute to JBAEL.
        </p>
        <div class="panel">
          <h3>Engineering. Operations. Service.</h3>
          <p>
            Explore our capabilities to understand the kind of equipment and
            engineering work JBAEL supports.
          </p>
          <a href="/services/">Explore our services →</a>
        </div>
      </aside>
      <div>
        <EnquiryForm kind="career" />
      </div>
    </div>
  </section>
</Layout>
