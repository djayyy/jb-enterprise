---
import Layout from "../layouts/Layout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { offices } from "../data/offices";
---

<Layout
  title="Contact our team"
  description="Contact JB Advanced Engineering Limited for power plant services, equipment supply and technical enquiries."
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Contact</span>
      </div>
      <p class="eyebrow">LET’S TALK ENGINEERING</p>
      <h1>Contact Us</h1>
      <p class="description">
        A technical question, a component requirement or a project ahead. Start
        a conversation with our team.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container form-layout">
      <aside class="form-aside">
        <h2>Here to help.</h2>
        <a href="mailto:info@jbepower.com">info@jbepower.com</a>
        <a href="mailto:sales@jbepower.com">sales@jbepower.com</a>
        <a href="tel:+919136020760">+91 91360 20760</a>
        <a href="tel:+919898320831">+91 98983 20831</a>
        <a href="tel:+919106459242">+91 91064 59242</a>
        {offices.map((office) => (
          <div class="office">
            <h3>{office.title}</h3>
            <p>{office.address}</p>
          </div>
        ))}
      </aside>
      <div>
        <EnquiryForm kind="contact" />
      </div>
    </div>
  </section>
</Layout>
