---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import CTA from "../components/CTA.astro";
import { company } from "../data/company";
import "../styles/about-reference.css";
const approachGroups = [
  company.approach.slice(0, 2),
  company.approach.slice(2, 4),
  company.approach.slice(4),
];
const capabilityColumns = [
  [3, 1, 2],
  [4, 5, 0],
];
const valueIcons = ["eye", "target", "flag"];
---

<Layout
  title="About JB Advanced Engineering"
  description={company.introduction}
>
  <div class="about-reference-page">
    <section
      class="about-reference-section about-who"
      id="who-we-are"
      aria-labelledby="who-title"
    >
      <img
        class="about-watermark about-who-watermark"
        src="/images/about-engineer.webp"
        srcset="/images/about-engineer-480.webp 480w, /images/about-engineer.webp 988w"
        sizes="(max-width: 600px) 100vw, 740px"
        width="988"
        height="882"
        alt=""
        decoding="async"
      />
      <div class="container about-section-content">
        <h1>About Us</h1>
        <h2 id="who-title">Who We Are</h2>
        <p class="about-subtitle">
          Engineering Reliability for Critical Power Assets
        </p>
        <p class="about-who-copy">{company.who}</p>
        <div class="about-approach">
          <h3>Our approach combines</h3>
          <div class="about-approach-columns">
            {approachGroups.map((group) => (
              <ul class="plain-checks">
                {group.map((point) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
        <p class="about-objective">{company.objective}</p>
      </div>
    </section>
    <section
      class="about-reference-section about-what"
      id="what-we-do"
      aria-labelledby="what-title"
    >
      <img
        class="about-watermark about-what-watermark"
        src="/images/about-what-background.webp"
        srcset="/images/about-what-background-480.webp 480w, /images/about-what-background.webp 1024w"
        sizes="(max-width: 600px) 100vw, 760px"
        width="1024"
        height="1024"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <div class="container about-section-content">
        <h2 id="what-title">What We Do</h2>
        <div class="about-what-layout">
          {capabilityColumns.map((indices, column) => (
            <div class="about-capability-column">
              {column === 0 && (
                <div class="about-capability-overview">
                  <h3>Integrated Power Plant Engineering Solutions</h3>
                  <p>
                    We support critical power generation equipment through a
                    comprehensive range of engineering and field services.
                  </p>
                </div>
              )}
              {indices.map((index) => (
                <article class="about-capability">
                  <h3>{company.what[index].title}</h3>
                  <p>{company.what[index].text}</p>
                </article>
              ))}
              {column === 1 && (
                <div class="about-image-links">
                  <a class="about-image-link" href="/services/">
                    <img
                      src="/images/about-services-link.webp"
                      width="480"
                      height="360"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <span>
                      Services <Icon name="diagonal" size={18} />
                    </span>
                  </a>
                  <a class="about-image-link" href="/equipment/">
                    <img
                      src="/images/about-spares-link.webp"
                      width="400"
                      height="309"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <span>
                      Spare Parts <Icon name="diagonal" size={18} />
                    </span>
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
    <section
      class="about-reference-section about-leadership"
      id="leadership"
      aria-labelledby="leadership-title"
    >
      <img
        class="about-leadership-background"
        src="/images/about-leadership-background.webp"
        srcset="/images/about-leadership-background-768.webp 768w, /images/about-leadership-background.webp 1536w"
        sizes="100vw"
        width="1536"
        height="1024"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <div class="container about-section-content about-leadership-layout">
        <div
          class="about-values"
          role="group"
          aria-label="Vision, Mission and Goal"
        >
          {company.values.map((value, index) => (
            <article class="about-value">
              <h3>{value.title}</h3>
              <Icon name={valueIcons[index]} size={36} />
              <p>{value.text}</p>
            </article>
          ))}
        </div>
        <article class="about-leadership-message">
          <h2 id="leadership-title">Leadership Message</h2>
          <p>{company.leadership}</p>
          <ul class="plain-checks">
            {company.commitments.map((point) => (
              <li>
                <Icon name="check" size={19} />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </section>
  </div>
  <section class="quality-strip" id="quality">
    <div class="container quality-inner">
      <div>
        <p class="eyebrow">QUALITY · ENVIRONMENT · HEALTH & SAFETY</p>
        <h2>Industry Certifications</h2>
      </div>
      <a class="button dark" href="/certifications/">
        View certificates <Icon name="arrow" />
      </a>
    </div>
  </section>
  <CTA
    title="Contact Us"
    text={company.objective}
    label="Contact Us"
    href="/contact/"
  />
</Layout>
