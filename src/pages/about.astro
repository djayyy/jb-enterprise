---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import CTA from "../components/CTA.astro";
import { company } from "../data/company";
---

<Layout
  title="About JB Advanced Engineering"
  description={company.introduction}
>
  <section class="page-hero detail-hero">
    <img
      src="/images/hero-modernisation.webp"
      width="1536"
      height="1024"
      alt=""
    />
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>About</span>
      </div>
      <p class="eyebrow">ABOUT US</p>
      <h1>
        Engineering Reliability
        <br />
        for Critical Power Assets
      </h1>
    </div>
  </section>
  <section class="section">
    <div class="container welcome-grid">
      <div>
        <p class="eyebrow">WHO WE ARE</p>
        <h2>JB Advanced Engineering Limited</h2>
        <p class="lead">{company.who}</p>
        <p>{company.objective}</p>
        <a
          class="text-link"
          href="/downloads/jbael-brochure.pdf"
          target="_blank"
          rel="noopener"
        >
          Company brochure <Icon name="download" />
        </a>
      </div>
      <aside class="why-panel">
        <h3>Our approach combines</h3>
        <ul class="plain-checks">
          {company.approach.map((a) => (
            <li>
              <Icon name="check" size={17} />
              {a}
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
  <section class="section pale" id="what-we-do">
    <div class="container">
      <p class="eyebrow">WHAT WE DO</p>
      <h2>
        Integrated Power Plant
        <br />
        Engineering Solutions
      </h2>
      <p class="section-intro">
        We support critical power generation equipment through a comprehensive
        range of engineering and field services.
      </p>
      <div class="what-grid">
        {company.what.map((x) => (
          <article>
            <h3>{x.title}</h3>
            <p>{x.text}</p>
          </article>
        ))}
      </div>
      <div class="hero-actions">
        <a href="/services/" class="button dark">
          Services <Icon name="arrow" />
        </a>
        <a href="/equipment/" class="button outline">
          Spare Parts <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
  <section class="section" id="leadership">
    <div class="container leadership-layout">
      <div class="company-values">
        {company.values.map((v) => (
          <article>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>
      <article class="leadership-message">
        <p class="eyebrow">JB ADVANCED ENGINEERING LIMITED</p>
        <h2>Leadership Message</h2>
        <p class="lead">{company.leadership}</p>
        <ul class="plain-checks">
          {company.commitments.map((c) => (
            <li>
              <Icon name="check" size={19} />
              {c}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>
  <section class="quality-strip" id="quality">
    <div class="container quality-inner">
      <div>
        <p class="eyebrow">QUALITY · ENVIRONMENT · HEALTH & SAFETY</p>
        <h2>Industry Certifications</h2>
      </div>
      <a class="button dark" href="/certifications/">
        View certificates <Icon name="arrow" />
      </a>
    </div>
  </section>
  <CTA
    title="Contact Us"
    text={company.objective}
    label="Contact Us"
    href="/contact/"
  />
</Layout>
