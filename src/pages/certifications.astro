---
import Layout from "../layouts/Layout.astro";
import CertificateGallery from "../components/CertificateGallery.astro";
---

<Layout
  title="Industry Certifications"
  description="JBAEL company certificate copies for ISO 9001, ISO 14001 and ISO 45001, as supplied in the website requirements."
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Certifications</span>
      </div>
      <p class="eyebrow">QUALITY · ENVIRONMENT · HEALTH & SAFETY</p>
      <h1>Industry Certifications</h1>
      <p class="description">
        Quality Management. Environmental Management. Occupational Health &
        Safety.
      </p>
    </div>
  </section>
  <CertificateGallery full />
</Layout>
