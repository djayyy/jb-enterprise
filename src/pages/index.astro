---
import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import CertificateGallery from "../components/CertificateGallery.astro";
import Icon from "../components/Icon.astro";
import CTA from "../components/CTA.astro";
import CatalogCard from "../components/CatalogCard.astro";
import { catalog } from "../data/catalog";
import { company, industries, coreCapabilities } from "../data/company";
import images from "../data/image-metadata.json";
const dimensions = images as Record<string, { width: number; height: number }>;
---

<Layout
  title="Turbine, Generator & Boiler Engineering"
  description={company.introduction}
>
  <HeroSlider />
  <section class="welcome-section" id="welcome" aria-labelledby="welcome-title">
    <img
      class="welcome-background"
      src="/images/welcome-plant.webp"
      srcset="/images/welcome-plant-640.webp 640w, /images/welcome-plant.webp 1279w"
      sizes="100vw"
      width="1279"
      height="851"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div class="welcome-geometry" aria-hidden="true"></div>
    <div class="container welcome-content">
      <h2 id="welcome-title">{company.welcome}</h2>
      <p class="welcome-introduction">{company.introduction}</p>
      <p>{company.coverage}</p>
      <div class="welcome-why">
        <h3>Why JBAEL?</h3>
        <p>{company.why}</p>
        <p>{company.whyMore}</p>
      </div>
      <div class="welcome-links">
        <a class="text-link" href="/about/">
          About JBAEL <Icon name="arrow" />
        </a>
        <a class="text-link" href="/about/#what-we-do">
          What We Do <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
  <section class="section pale home-offerings" id="industries">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">POWER GENERATION</p>
          <h2>Industries Served</h2>
        </div>
        <p>
          JBAEL provides specialized engineering support across power generation
          sectors worldwide.
        </p>
      </div>
      <div class="industry-cards">
        {industries.map((item, i) => (
          <a
            href={item.url}
            class="industry-card offering-card"
            style={`--industry-focus: ${item.focus}`}
          >
            <img
              src={`/images/${item.image}.webp`}
              alt=""
              srcset={[`${item.image}-480`, `${item.image}-800`, item.image]
                .map((id) => `/images/${id}.webp ${dimensions[id].width}w`)
                .join(", ")}
              sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1100px) calc((100vw - 76px) / 2), 300px"
              width={dimensions[item.image].width}
              height={dimensions[item.image].height}
              loading="lazy"
              decoding="async"
            />
            <div class="offering-card-copy">
              <h3>
                {item.title}
                <Icon name="diagonal" />
              </h3>
              <p>{item.text}</p>
              <span class="industry-action offering-card-action">
                {i < 2 ? "Explore services" : "Contact Us"}{" "}
                <Icon name="arrow" size={17} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section home-offerings" id="capabilities">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">WHAT WE DO</p>
          <h2>Core Engineering Services</h2>
        </div>
        <a href="/services/" class="text-link">
          Browse by power plant <Icon name="arrow" />
        </a>
      </div>
      <div class="catalog-grid" data-home-services>
        {coreCapabilities.map((c) => {
          const url = c.anchor
            ? catalog.legacy.detailHashes[`/services/${c.slug}/#${c.anchor}`]
            : `/services/${c.slug}/`;
          const node = catalog.servicePages.find((n) => n.url === url)!;
          return (
            <CatalogCard
              home
              node={{ ...node, title: c.title, summary: c.text }}
            />
          );
        })}
      </div>
    </div>
  </section>
  <section class="section pale home-offerings" id="equipment-supply">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EQUIPMENT SUPPLY</p>
          <h2>Equipment & Parts</h2>
        </div>
        <a class="text-link" href="/equipment/">
          View all equipment <Icon name="arrow" />
        </a>
      </div>
      <div class="catalog-grid">
        {catalog.equipmentCategories.map((node) => (
          <CatalogCard home node={node} />
        ))}
      </div>
    </div>
  </section>
  <CertificateGallery />
  <CTA
    title="Request a Quote"
    text="At JB Advanced Engineering Limited, we are committed to meeting our customers’ needs with readiness, reliability, and excellence."
    label="Request a Quote"
  />
</Layout>
