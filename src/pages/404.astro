---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="Return to JBAEL engineering services or the homepage."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">404 · PAGE NOT FOUND</p>
      <h1>
        Let’s get you
        <br />
        back on track.
      </h1>
      <p class="description">
        This page may have moved, or the address may be incorrect.
      </p>
      <div class="hero-actions">
        <a class="button" href="/">
          Go to homepage
        </a>
        <a class="text-link light-link" href="/services/">
          Explore services →
        </a>
      </div>
    </div>
  </section>
</Layout>
