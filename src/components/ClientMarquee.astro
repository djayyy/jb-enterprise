---
import clients from "../data/clients.json";
---

<section class="clients-section" aria-labelledby="clients-title">
  <div class="container clients-heading">
    <h2 id="clients-title">Trusted By Industry Leaders</h2>
  </div>
  <div class="client-marquee">
    <div
      class="clients-window"
      tabindex="0"
      role="region"
      aria-label="Client logos"
    >
      <div class="clients-track">
        {[false, true].map((duplicate) => (
          <ul
            class="clients-group"
            aria-hidden={duplicate ? "true" : undefined}
          >
            {clients.map((client) => (
              <li class="client-logo">
                <img
                  src={client.image}
                  alt={client.name}
                  width={client.width}
                  height={client.height}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>
