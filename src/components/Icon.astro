---
const { name = "arrow", size = 20 } = Astro.props;
const paths: Record<string, string> = {
  arrow: "M5 12h14m-6-6 6 6-6 6",
  diagonal: "M6 18 18 6M6 6h12v12",
  search: "m21 21-5-5M10 17a7 7 0 1 0 0-14 7 7 0 0 0 0 14",
  check: "m5 12 4 4L19 6",
  plus: "M12 5v14M5 12h14",
  bolt: "m13 2-9 12h7l-1 8 10-13h-8l1-7",
  gear: "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8M12 2v3m0 14v3M2 12h3m14 0h3M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2",
  shield: "m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3m-4 9 3 3 5-6",
  download: "M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5",
  globe:
    "M3 12h18M12 2c-6 5-6 15 0 20 6-5 6-15 0-20M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20",
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name] || paths.arrow} />
</svg>
