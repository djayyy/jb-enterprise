---
import Icon from "./Icon.astro";
const {
  title = "Request a Quote",
  text = "At JB Advanced Engineering Limited, we are committed to meeting our customers’ needs with readiness, reliability, and excellence.",
  href = "/request-a-quote/",
  label = "Request a Quote",
} = Astro.props;
---

<section class="cta-section">
  <div class="container cta-inner">
    <div>
      <p class="eyebrow">CONTACT JBAEL</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a href={href} class="button">
      {label}
      <Icon name="diagonal" />
    </a>
  </div>
</section>
