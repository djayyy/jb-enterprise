---
const {
  title = "Request a Quote",
  text = "At JB Advanced Engineering Limited, we are committed to meeting our customers’ needs with readiness, reliability, and excellence.",
  href = "/request-a-quote/",
  label = "Request a Quote",
} = Astro.props;
---

<section class="cta-section quote-banner">
  <svg
    class="quote-corner quote-corner--top"
    viewBox="0 0 90 80"
    aria-hidden="true"
  >
    <path d="M5 5h80L45 74Z" />
  </svg>
  <div class="container cta-inner">
    <div class="quote-banner-copy">
      <h2>
        <a href={href} aria-label={label}>
          {title}
          <svg class="quote-document" viewBox="0 0 80 90" aria-hidden="true">
            <g transform="rotate(-6 36 42)">
              <rect
                x="12"
                y="5"
                width="51"
                height="70"
                rx="1"
                fill="white"
                stroke="#aab6bf"
                stroke-width="2"
              />
              <path
                d="M20 17h34M20 25h34M20 33h34M20 41h34M20 49h34M20 57h34M20 65h26"
                stroke="#7d8992"
                stroke-width="2"
              />
            </g>
            <path d="m50 78 23-21 4 5-24 20-7 2Z" fill="#203746" />
          </svg>
        </a>
      </h2>
      <p>{text}</p>
    </div>
  </div>
  <svg
    class="quote-corner quote-corner--bottom"
    viewBox="0 0 90 80"
    aria-hidden="true"
  >
    <path d="M5 75h80L45 6Z" />
  </svg>
</section>
