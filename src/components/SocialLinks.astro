---
const channels = [
  {
    name: "LinkedIn",
    mark: "in",
    url: "https://www.linkedin.com/company/jbenterpriseindia/",
  },
  { name: "X / Twitter", mark: "𝕏" },
  { name: "YouTube", mark: "▶" },
  { name: "Facebook", mark: "f" },
  { name: "Instagram", mark: "◎" },
];
---

<div class="social-links" aria-label="Social media">
  {channels.map((channel) =>
    channel.url ? (
      <a
        href={channel.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${channel.name} (opens in a new tab)`}
        title={channel.name}
      >
        {channel.mark}
      </a>
    ) : (
      <button
        type="button"
        disabled
        aria-label={channel.name}
        title={channel.name}
      >
        {channel.mark}
      </button>
    ),
  )}
</div>
