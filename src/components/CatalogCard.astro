---
import images from "../data/image-metadata.json";
interface Props {
  home?: boolean;
  node: {
    url: string;
    title: string;
    summary: string;
    image: string;
    level: string;
    kind: string;
    categoryTitle: string;
  };
}
const { node, home = false } = Astro.props;
const size = (images as Record<string, { width: number; height: number }>)[
  node.image
];
---

<a
  class:list={[
    "catalog-card",
    {
      "offering-card": home,
      "catalog-card--component": node.image === "critical-component",
    },
  ]}
  href={node.url}
  data-catalog-card
  data-search={`${node.title} ${node.summary} ${node.categoryTitle}`.toLowerCase()}
>
  <div class:list={["catalog-card-art", { "offering-card-art": home }]}>
    <img
      src={`/images/${node.image}.webp`}
      width={size.width}
      height={size.height}
      alt=""
      loading="lazy"
    />
    <span class="catalog-card-kind">
      {node.level === "category"
        ? "Category"
        : node.kind === "services"
          ? "Engineering service"
          : "Equipment & parts"}
    </span>
  </div>
  <div class:list={["catalog-card-copy", { "offering-card-copy": home }]}>
    <h3>{node.title}</h3>
    <p>{node.summary}</p>
    <span
      class:list={["catalog-card-action", { "offering-card-action": home }]}
    >
      View {node.level === "category" ? "category" : "details"}
      <span aria-hidden="true">↗</span>
    </span>
  </div>
</a>
