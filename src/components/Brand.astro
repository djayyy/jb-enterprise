---
interface Props {
  footer?: boolean;
}
const { footer = false } = Astro.props;
---

<a
  href="/"
  class:list={["brand", "complete-brand", { "footer-brand": footer }]}
  aria-label="JB Advanced Engineering Limited home"
>
  <img
    src={footer ? "/images/jbael-brand-248.webp" : "/images/jbael-logo.png"}
    srcset={
      footer
        ? "/images/jbael-brand-248.webp 248w, /images/jbael-brand.webp 496w"
        : undefined
    }
    sizes={
      footer
        ? "(max-width: 1100px) 48px, 57px"
        : "(max-width: 600px) 42px, (max-width: 1100px) 48px, 57px"
    }
    width={footer ? 496 : 321}
    height={footer ? 481 : 324}
    alt=""
    decoding="async"
    loading={footer ? "lazy" : "eager"}
  />
  {!footer && (
    <span>
      JB ADVANCED<small>ENGINEERING LIMITED</small>
      <em>Powering precision, Engineering the future</em>
    </span>
  )}
</a>
