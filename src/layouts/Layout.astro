---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import "../styles/v02.css";
import "../styles/v03.css";
import "../styles/v05.css";
import "../styles/v06.css";
import "../styles/company-review.css";
import "../styles/responsive/desktop.css";
import "../styles/responsive/mobile.css";
import NavigationDropdown from "../components/NavigationDropdown.astro";
import Brand from "../components/Brand.astro";
import MockDialogs from "../components/MockDialogs.astro";
import "../styles/mock-forms.css";
import { offices } from "../data/offices";
const {
  title = "JB Advanced Engineering Limited",
  description = "Integrated engineering, refurbishment and lifecycle support for critical power generation assets.",
} = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#102d3c" />
    <link rel="icon" href="/images/jbael-logo.png" />
    <title>{title} | JBAEL</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <div class="utility">
      <div class="container utility-inner">
        <div class="utility-phones">
          <a href="tel:+919136020760">+91 9136020760</a>
          <span>|</span>
          <a href="tel:+919898320831">+91 9898320831</a>
          <span>|</span>
          <a href="tel:+919106459242">+91 9106459242</a>
        </div>
        <div class="utility-emails">
          <a href="mailto:info@jbepower.com">info@jbepower.com</a>
          <span>|</span>
          <a href="mailto:sales@jbepower.com">sales@jbepower.com</a>
        </div>
        <SocialLinks />
      </div>
    </div>
    <header class="header">
      <div class="container header-inner">
        <Brand />
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="main-nav"
        >
          Menu <span aria-hidden="true">☰</span>
        </button>
        <nav id="main-nav" aria-label="Main navigation">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>
            Home
          </a>
          <a
            href="/about/"
            aria-current={path.startsWith("/about/") ? "page" : undefined}
          >
            About
          </a>
          <NavigationDropdown
            kind="services"
            active={path.startsWith("/services/")}
          />
          <NavigationDropdown
            kind="equipment"
            active={path.startsWith("/equipment/")}
          />
          <a
            href="/contact/"
            aria-current={path.startsWith("/contact/") ? "page" : undefined}
          >
            Contact
          </a>
          <a class="button small" href="/request-a-quote/">
            Request a quote <Icon name="diagonal" size={17} />
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="container">
        <div class="footer-top">
          <div>
            <Brand footer />
            <div class="footer-offices" aria-label="Company locations">
              {offices.map((office) => (
                <address>
                  <strong>{office.title}</strong>
                  <span>{office.address}</span>
                </address>
              ))}
            </div>
            <p>Powering precision, Engineering the future.</p>
            <SocialLinks />
          </div>
          <div>
            <h3>Explore</h3>
            <a href="/services/">Engineering services</a>
            <a href="/equipment/">Equipment supply</a>
            <a href="/about/">About JBAEL</a>
            <a href="/careers/">Careers</a>
          </div>
          <div class="footer-resources">
            <h3>Resources</h3>
            <a href="/certifications/">Industry Certifications</a>
            <a
              href="/downloads/jbael-brochure.pdf"
              target="_blank"
              rel="noopener"
            >
              Company brochure ↗
            </a>
            <a
              href="/downloads/executed-projects.pdf"
              target="_blank"
              rel="noopener"
            >
              Executed Projects ↗
            </a>
            <a
              href="/downloads/spares-supply.pdf"
              target="_blank"
              rel="noopener"
            >
              Spares supply ↗
            </a>
            <a
              href="/downloads/reverse-engineering-manufacturing-portfolio.pdf"
              target="_blank"
              rel="noopener"
            >
              Reverse Engineering &amp; Manufacturing Portfolio&nbsp;↗
            </a>
            <a href="/privacy/">Privacy information</a>
          </div>
          <div>
            <h3>Let’s talk engineering</h3>
            <a href="mailto:sales@jbepower.com">sales@jbepower.com</a>
            <a href="tel:+919898320831">+91 98983 20831</a>
            <a class="footer-contact" href="/contact/">
              Contact our team <Icon name="arrow" size={16} />
            </a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>
            © {new Date().getFullYear()} JB Advanced Engineering Limited
          </span>
          <span>Powering precision. Engineering the future.</span>
          <a
            href="#main"
            class="back-to-top"
            aria-label="Back to top"
            title="Back to top"
          >
            <Icon name="up" size={22} />
          </a>
        </div>
      </div>
    </footer>
    <MockDialogs />
    <script>
      import { settleTarget } from "../lib/scroll-target";
      import { alignHeaderNavigation } from "../lib/menu-position.mjs";
      if (
        !["/services/", "/equipment/"].includes(
          location.pathname.replace(/\/?$/, "/"),
        )
      ) {
        const followHash = () => {
          try {
            const id = decodeURIComponent(location.hash.slice(1));
            if (id) settleTarget(id);
          } catch {
            /* Ignore malformed external fragments. */
          }
        };
        followHash();
        window.addEventListener("hashchange", followHash);
      }
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#main-nav");
      const header = document.querySelector<HTMLElement>(".header")!;
      const compact = matchMedia("(max-width:1000px)");
      const alignNavigation = () => {
        alignHeaderNavigation({
          nav,
          brand: header.querySelector(".brand"),
          viewportWidth: document.documentElement.clientWidth,
          compact: compact.matches,
        });
        document.dispatchEvent(new Event("navigationlayout"));
      };
      alignNavigation();
      window.addEventListener("resize", alignNavigation);
      compact.addEventListener("change", alignNavigation);
      document.fonts.ready.then(alignNavigation);
      const utility = document.querySelector<HTMLElement>(".utility");
      const measureHeader = () => {
        const bounds = header.getBoundingClientRect();
        document.documentElement.style.setProperty(
          "--site-header-height",
          `${bounds.height}px`,
        );
        document.documentElement.style.setProperty(
          "--site-chrome-height",
          `${bounds.height + (utility?.getBoundingClientRect().height || 0)}px`,
        );
        header.style.setProperty("--header-height", `${bounds.height}px`);
        header.style.setProperty(
          "--header-bottom",
          `${Math.max(0, bounds.bottom)}px`,
        );
      };
      const headerObserver = new ResizeObserver(measureHeader);
      headerObserver.observe(header);
      if (utility) headerObserver.observe(utility);
      window.addEventListener("scroll", measureHeader, { passive: true });
      window.addEventListener("resize", measureHeader);
      window.visualViewport?.addEventListener("resize", measureHeader);
      measureHeader();
      const close = () => {
        toggle?.setAttribute("aria-expanded", "false");
        nav?.classList.remove("is-open");
        document
          .querySelectorAll<HTMLDetailsElement>("[data-nav-dropdown]")
          .forEach((d) => (d.open = false));
      };
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        nav?.classList.toggle("is-open", open);
        if (!open) close();
      });
      document.addEventListener("pointerdown", (event) => {
        if (compact.matches && !header.contains(event.target as Node)) close();
      });
      compact.addEventListener("change", () => {
        const restoreFocus =
          compact.matches && nav?.contains(document.activeElement);
        close();
        if (restoreFocus) toggle?.focus({ preventScroll: true });
      });
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          close();
          toggle.focus();
        }
      });
      nav?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", (e) => {
          if (
            !e.ctrlKey &&
            !e.metaKey &&
            !e.shiftKey &&
            !e.altKey &&
            e.button === 0
          )
            close();
        }),
      );
    </script>
  </body>
</html>
